<!-- 获取OpenID页面 -->
<view class="container">
  <view class="header">
    <text class="title">获取OpenID</text>
    <text class="subtitle">用于配置管理员权限</text>
  </view>

  <view class="content">
    <view class="info-section">
      <text class="info-title">说明</text>
      <text class="info-text">
        OpenID是微信用户的唯一标识符。将您的OpenID配置到管理员列表中，即可获得管理后台访问权限。
      </text>
    </view>

    <view class="openid-section">
      <text class="label">您的OpenID：</text>
      <view class="openid-display">
        <text class="openid-text">{{isLoading ? '正在获取...' : openid}}</text>
        <button 
          wx:if="{{showCopyButton}}" 
          class="copy-btn" 
          bindtap="copyOpenid"
        >
          复制
        </button>
      </view>
    </view>

    <view class="steps-section">
      <text class="steps-title">配置步骤：</text>
      <view class="step-item">
        <text class="step-number">1.</text>
        <text class="step-text">复制上方的OpenID</text>
      </view>
      <view class="step-item">
        <text class="step-number">2.</text>
        <text class="step-text">打开云函数 checkAdminPermission</text>
      </view>
      <view class="step-item">
        <text class="step-number">3.</text>
        <text class="step-text">将OpenID添加到 ADMIN_OPENIDS 数组中</text>
      </view>
      <view class="step-item">
        <text class="step-number">4.</text>
        <text class="step-text">重新部署云函数</text>
      </view>
    </view>
  </view>

  <view class="back-btn" bindtap="goBack">
    <text class="back-text">返回</text>
  </view>
</view>