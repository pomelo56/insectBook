/* 获取OpenID页面样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 50rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.content {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.info-section {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: #f8f9fa;
  border-radius: 15rpx;
  border-left: 4rpx solid #007bff;
}

.info-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
  display: block;
}

.info-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.openid-section {
  margin-bottom: 40rpx;
}

.label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 15rpx;
}

.openid-display {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  border: 1px solid #e9ecef;
}

.openid-text {
  flex: 1;
  font-size: 24rpx;
  color: #333;
  word-break: break-all;
  line-height: 1.4;
}

.copy-btn {
  background-color: #007bff;
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  font-weight: bold;
  margin-left: 20rpx;
  height: auto;
  line-height: 1;
}

.copy-btn:active {
  background-color: #0056b3;
  transform: translateY(1rpx);
}

.steps-section {
  background: #fff3cd;
  border: 1px solid #ffeaa7;
  border-radius: 12rpx;
  padding: 25rpx;
}

.steps-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #856404;
  margin-bottom: 20rpx;
  display: block;
}

.step-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 15rpx;
}

.step-number {
  font-size: 24rpx;
  font-weight: bold;
  color: #856404;
  margin-right: 15rpx;
  min-width: 30rpx;
  line-height: 1.4;
}

.step-text {
  font-size: 24rpx;
  color: #856404;
  line-height: 1.4;
  flex: 1;
}

.back-btn {
  position: fixed;
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  background-color: rgba(255, 255, 255, 0.9);
  border: 1px solid #ddd;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.1);
}

.back-text {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.back-btn:active {
  background-color: #f8f9fa;
  transform: translateX(-50%) scale(0.95);
}

/* 响应式调整 */
@media (max-width: 600rpx) {
  .container {
    padding: 30rpx 20rpx;
  }
  
  .header {
    margin-bottom: 30rpx;
  }
  
  .title {
    font-size: 40rpx;
  }
  
  .content {
    padding: 30rpx 20rpx;
  }
  
  .info-section {
    padding: 20rpx;
  }
  
  .info-title {
    font-size: 28rpx;
  }
  
  .info-text {
    font-size: 24rpx;
  }
  
  .openid-display {
    padding: 15rpx;
  }
  
  .openid-text {
    font-size: 22rpx;
  }
  
  .copy-btn {
    padding: 10rpx 20rpx;
    font-size: 22rpx;
  }
  
  .steps-title {
    font-size: 26rpx;
  }
  
  .step-number {
    font-size: 22rpx;
  }
  
  .step-text {
    font-size: 22rpx;
  }
}