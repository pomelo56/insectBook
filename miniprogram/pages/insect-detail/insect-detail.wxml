<!-- pages/insect-detail/insect-detail.wxml -->
<view class="container">
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view class="error-container" wx:if="{{error && !loading}}">
    <image src="/images/error.png" class="error-image"></image>
    <text class="error-text">{{error}}</text>
    <button class="retry-btn" bindtap="loadInsectDetail">重试</button>
  </view>

  <!-- 昆虫详情内容 -->
  <view class="detail-content" wx:if="{{!loading && !error && insectInfo}}">
    <!-- 昆虫图片 -->
    <view class="insect-image-container">
      <image 
        class="insect-image" 
        src="{{insectInfo.displayImageUrl || insectInfo.imageUrl || '/images/default_insect.png'}}" 
        mode="aspectFit"
        binderror="onImageError"
      ></image>
    </view>

    <!-- 昆虫基本信息 -->
    <view class="basic-info">
      <text class="insect-name">{{insectInfo.name}}</text>
      <text class="insect-scientific-name">{{insectInfo.scientificName || '暂无学名'}}</text>
    </view>

    <!-- 发现信息 -->
    <view class="found-info">
      <text class="info-label">发现信息</text>
      <text class="info-text">发现次数：{{insectInfo.foundCount || 0}}次</text>
      <!-- 使用JavaScript中预先处理好的日期字段 -->
      <text class="info-text">最近发现：{{insectInfo.lastFoundDate || '暂无记录'}}</text>
    </view>

    <!-- 分类信息 -->
    <view class="classification-section" wx:if="{{insectInfo.classification}}">
      <view class="section-title">
        <text>分类信息</text>
      </view>
      <view class="classification-content">
        <view class="classification-item">
          <text class="classification-label">界：</text>
          <text class="classification-value">{{insectInfo.classification['界']}}</text>
        </view>
        <view class="classification-item">
          <text class="classification-label">门：</text>
          <text class="classification-value">{{insectInfo.classification['门']}}</text>
        </view>
        <view class="classification-item">
          <text class="classification-label">纲：</text>
          <text class="classification-value">{{insectInfo.classification['纲']}}</text>
        </view>
        <view class="classification-item">
          <text class="classification-label">目：</text>
          <text class="classification-value">{{insectInfo.classification['目']}}</text>
        </view>
        <view class="classification-item">
          <text class="classification-label">科：</text>
          <text class="classification-value">{{insectInfo.classification['科']}}</text>
        </view>
      </view>
    </view>

    <!-- 百度百科内容 -->
    <view class="baike-section">
      <view class="section-title">
        <text>百度百科</text>
      </view>
      <view class="baike-content">
        <text>{{baikeContent}}</text>
      </view>
    </view>
    
    <!-- 观察笔记显示区域已隐藏 -->
    <!-- 观察笔记悬浮按钮已隐藏 -->
  </view>
</view>