/* pages/insect-detail/insect-detail.wxss */
.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  display: flex;
  flex-direction: column;
}

/* 加载状态 */
.loading-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 8rpx solid #f3f3f3;
  border-top: 8rpx solid #4CAF50;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 30rpx;
  font-size: 28rpx;
  color: #666;
}

/* 错误状态 */
.error-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.error-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.error-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.retry-btn {
  background-color: #4CAF50;
  color: white;
  border-radius: 8rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
}

/* 详情内容 */
.detail-content {
  flex: 1;
  padding: 30rpx;
}

/* 昆虫图片 */
.insect-image-container {
  width: 100%;
  height: 400rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.insect-image {
  width: 100%;
  height: 100%;
}

/* 基本信息 */
.basic-info {
  text-align: center;
  margin-bottom: 30rpx;
}

.insect-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.insect-scientific-name {
  font-size: 28rpx;
  color: #666;
  font-style: italic;
}

/* 发现信息 */
.found-info {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.info-label {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.info-text {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 15rpx;
}

.info-text:last-child {
  margin-bottom: 0;
}

/* 分类信息 */
.classification-section {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.classification-content {
  margin-top: 10rpx;
}

.classification-item {
  display: flex;
  margin-bottom: 15rpx;
  align-items: flex-start;
}

.classification-item:last-child {
  margin-bottom: 0;
}

.classification-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 10rpx;
  min-width: 40rpx;
}

.classification-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

/* 百度百科内容 */
.baike-section {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.baike-content {
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
  text-align: justify;
}

/* 观察笔记显示区域样式 */
.notes-section {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.notes-content {
  font-size: 28rpx;
  line-height: 48rpx;
  color: #333;
  margin-top: 20rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.notes-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
  text-align: right;
}

/* 观察笔记悬浮按钮样式 */
.notes-float-btn {
  position: fixed;
  right: 40rpx;
  bottom: 100rpx;
  width: 120rpx;
  height: 120rpx;
  background-color: #4CAF50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  z-index: 999;
}

.notes-float-btn:active {
  transform: scale(0.95);
}

.notes-icon {
  width: 60rpx;
  height: 60rpx;
}

/* 响应式调整 */
@media screen and (max-width: 600rpx) {
  .container {
    padding-bottom: 30rpx;
  }
  
  .detail-content {
    padding: 20rpx;
  }
  
  .insect-image-container {
    height: 300rpx;
  }
  
  .insect-name {
    font-size: 40rpx;
  }
  
  .baike-content {
    font-size: 26rpx;
  }
}