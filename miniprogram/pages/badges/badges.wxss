/* pages/badges/badges.wxss */
.container {
  background-color: #f5f7fa;
  min-height: 100vh;
  padding-bottom: 100rpx;
}

/* 顶部导航 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  background-color: #4CAF50;
  color: white;
  position: sticky;
  top: 0;
  z-index: 10;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
}

.back-btn, .settings-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon, .settings-icon {
  width: 40rpx;
  height: 40rpx;
  color: white;
}

/* 总体进度 */
.progress-container {
  margin: 30rpx;
  padding: 40rpx;
  background-color: white;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.progress-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: block;
}

.progress-count {
  font-size: 48rpx;
  font-weight: bold;
  color: #4CAF50;
  float: right;
}

.progress-bar {
  width: 100%;
  height: 20rpx;
  background-color: #e0e0e0;
  border-radius: 10rpx;
  margin: 30rpx 0;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: #4CAF50;
  border-radius: 10rpx;
}

.progress-text {
  font-size: 28rpx;
  color: #666;
  display: block;
}

/* 等级体系 */
.levels-section {
  margin: 30rpx;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.trophy-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

.section-title text {
  font-size: 32rpx;
  font-weight: bold;
}

/* 等级卡片网格 */
.levels-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
}

/* 等级卡片 */
.level-card {
  background-color: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
}

.level-card.completed {
  border: 2rpx solid #4CAF50;
}

.level-card.current {
  border: 3rpx solid #2196F3;
  box-shadow: 0 4rpx 15rpx rgba(33, 150, 243, 0.2);
}

.level-badge {
  position: absolute;
  top: 0;
  right: 0;
  background-color: #4CAF50;
  color: white;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  border-bottom-left-radius: 20rpx;
}

.level-icon {
  width: 150rpx;
  height: 150rpx;
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 50%;
}

.level-icon image {
  width: 120rpx;
  height: 120rpx;
}

.level-name {
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 10rpx;
  display: block;
}

.level-status {
  font-size: 24rpx;
  color: #666;
  text-align: center;
  margin-bottom: 20rpx;
  display: block;
}

.level-progress-bar {
  width: 100%;
  height: 12rpx;
  background-color: #e0e0e0;
  border-radius: 6rpx;
  margin-bottom: 10rpx;
  overflow: hidden;
}

.level-progress-fill {
  height: 100%;
  background-color: #4CAF50;
  border-radius: 6rpx;
}

.level-card.current .level-progress-fill {
  background-color: #2196F3;
}

.level-progress-text {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  display: block;
}

/* 相机按钮 */
.camera-btn {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  width: 120rpx;
  height: 120rpx;
  background-color: #4CAF50;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}

.camera-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 5rpx;
}

.camera-text {
  font-size: 20rpx;
  color: white;
}