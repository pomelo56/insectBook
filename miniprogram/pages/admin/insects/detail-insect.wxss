/* miniprogram/pages/admin/insects/detail-insect.wxss */
.detail-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  font-size: 28rpx;
}

/* 头部样式 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.back-button {
  display: flex;
  align-items: center;
  padding: 10rpx;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 8rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.header-right {
  width: 200rpx;
  display: flex;
  justify-content: flex-end;
}

.refresh-button {
  display: flex;
  align-items: center;
  padding: 10rpx;
  color: #4CAF50;
  font-size: 28rpx;
}

.refresh-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
}

.refresh-text {
  font-size: 28rpx;
  color: #4CAF50;
}

/* 加载状态 */
.loading-container, .empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  color: #999;
}

.loading-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 30rpx;
}

/* 内容区域 */
.insect-detail {
  padding: 140rpx 30rpx 100rpx;
}

/* 信息卡片 */
.info-card {
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background-color: #fafafa;
}

.info-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 昆虫头部信息 */
.insect-header {
  display: flex;
  padding: 30rpx;
}

.image-container {
  margin-right: 30rpx;
}

.insect-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

.basic-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.info-row {
  display: flex;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  color: #666;
  min-width: 140rpx;
}

.value {
  color: #333;
  flex: 1;
  word-break: break-all;
}

/* 百科信息区域 */
.encyclopedia-card {
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  padding-bottom: 30rpx;
}

.encyclopedia-content {
  padding: 30rpx;
}

.content-textarea {
  width: 100%;
  min-height: 300rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background-color: #fafafa;
}

.char-count {
  font-size: 24rpx;
  color: #999;
  text-align: right;
  display: block;
  margin-top: 10rpx;
}

.action-buttons {
  padding: 0 30rpx;
}

.action-buttons button {
  margin-top: 0;
  font-size: 28rpx;
}

/* 其他信息区域 */
.info-section {
  padding: 30rpx;
}

/* 适配不同尺寸屏幕 */
@media (min-width: 768px) {
  .detail-container {
    max-width: 800rpx;
    margin: 0 auto;
  }
  
  .info-row {
    font-size: 30rpx;
  }
  
  .insect-image {
    width: 240rpx;
    height: 240rpx;
  }
}