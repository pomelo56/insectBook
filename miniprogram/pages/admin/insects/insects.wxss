/* miniprogram/pages/admin/insects/insects.wxss */
.insects-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

.header {
  margin-bottom: 20rpx;
  padding: 30rpx;
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sync-btn {
  margin-left: 20rpx;
  font-size: 28rpx;
  height: 70rpx;
  line-height: 70rpx;
}

.search-bar {
  position: relative;
  background-color: #fff;
  border-radius: 10rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.search-input {
  flex: 1;
  height: 88rpx;
  font-size: 32rpx;
  color: #333;
}

.search-icon {
  width: 40rpx;
  height: 40rpx;
}

.filter-bar {
  display: flex;
  justify-content: space-between;
  background-color: #fff;
  border-radius: 10rpx;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.filter-picker, .sort-picker {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
}

.filter-picker {
  border-right: 1rpx solid #f0f0f0;
}

.picker-item {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  color: #666;
}

.arrow-icon, .sort-icon {
  width: 30rpx;
  height: 30rpx;
  margin-left: 10rpx;
}

.insects-list {
  background-color: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.insect-item {
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

/* 整个项目作为可点击区域 */
.insect-content {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #fff;
  transition: background-color 0.2s;
  width: 100%;
  box-sizing: border-box;
}

.insect-content:active {
  background-color: #f5f5f5;
}

/* 图片部分 */
.image-container {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: #f0f0f0;
  position: relative;
  flex-shrink: 0;
}

.insect-image {
  width: 100%;
  height: 100%;
  display: block;
}

.no-image-tag {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(0, 0, 0, 0.6);
  color: white;
  font-size: 24rpx;
  padding: 8rpx 0;
  text-align: center;
}

/* 信息部分 */
.insect-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  justify-content: center;
}

.insect-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.insect-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.meta-item {
  font-size: 28rpx;
  color: #666;
}

.insect-time {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.insect-id {
  font-size: 20rpx;
  color: #ccc;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 箭头部分 */
.arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  flex-shrink: 0;
  min-width: 40rpx;
}

.arrow image {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.6;
}

/* 操作按钮区域 */
.action-buttons {
  display: flex;
  padding: 0 24rpx 24rpx;
  gap: 16rpx;
  justify-content: flex-end;
}

.config-button {
  margin: 0;
  font-size: 28rpx;
  height: 64rpx;
  line-height: 64rpx;
}

.preview-button {
  margin: 0;
  font-size: 28rpx;
  height: 64rpx;
  line-height: 64rpx;
}

.loading, .empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.loading-icon, .empty-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 20rpx;
}

.load-more {
  text-align: center;
  padding: 20rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 适配不同尺寸屏幕 */
@media (min-width: 768px) {
  .insects-container {
    padding: 40rpx;
  }
  
  .insect-item {
    padding: 40rpx;
  }
}

.insect-image-container {
  /* 移除动画，避免图片闪烁 */
}