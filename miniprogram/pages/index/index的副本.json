/* pages/index/index.wxss */
.header {
  background-color: #4CAF50;
  color: white;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
}

.header-more {
  font-size: 48rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.8);
}

.container {
  padding: 20rpx;
  background-color: #f0f8f4;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 发现进度区域 */
.discovery-progress {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.progress-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #4CAF50;
}

.progress-count {
  font-size: 32rpx;
  color: #4CAF50;
  font-weight: 500;
}

.progress-bar {
  height: 20rpx;
  background-color: #e0e0e0;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.progress-fill {
  height: 100%;
  background-color: #4CAF50;
  border-radius: 10rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 28rpx;
  color: #666;
}

/* 内容区域 */
.content-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* 昆虫收藏区域 */
.insects-collection {
  margin-bottom: 30rpx;
  flex-shrink: 0;
}

.collection-header {
  margin-bottom: 30rpx;
}

.collection-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4CAF50;
}

/* 网格布局容器 */
.insects-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0;
  justify-content: space-between;
}

/* 昆虫卡片样式 */
.insect-item {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 32%;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.insect-card {
  position: relative;
  background: white;
  border-radius: 20rpx;
  padding: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}

/* 新发现标签 */
.new-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #4CAF50;
  color: white;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.insect-image {
  width: 100%;
  aspect-ratio: 1;
  background-color: #f0f8f4;
  object-fit: cover;
}

.insect-name {
  font-size: 30rpx;
  padding: 16rpx 0;
  font-weight: 500;
  color: #4CAF50;
  text-align: center;
  width: 100%;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 120rpx;
  text-align: center;
}

.empty-image {
  width: 320rpx;
  height: 320rpx;
  opacity: 0.7;
  margin-bottom: 36rpx;
}

.empty-text {
  font-size: 36rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.empty-subtext {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 48rpx;
}

/* 卡片通用样式 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 按钮样式 */
.primary-btn {
  background-color: #4CAF50;
  color: white;
  border-radius: 8rpx;
  padding: 16rpx 32rpx;
  font-size: 32rpx;
  border: none;
}

.primary-btn:active {
  background-color: #45a049;
}

/* 滚动条样式优化 */
::-webkit-scrollbar {
  display: none;
}

/* 响应式调整 */
@media (max-width: 600rpx) {
  .insect-item {
    width: 31%;
  }
  
  .insect-image {
    aspect-ratio: 1;
    object-fit: cover;
  }
  
  .progress-number {
    font-size: 40rpx;
  }
}