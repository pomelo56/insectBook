<!--pages/index/index.wxml-->
<view class="container" style="background-color: #f0f9f2;">
  <!-- 发现进度与勋章整合区域 -->
  <view class="discovery-badges-section">
    <view class="badges-entry" bindtap="goToLevelDetail">
      <view class="badges-content">
        <view class="current-badge-icon">
          <image src="{{currentBadge.icon}}" class="badge-image" />
          <view class="badge-level">Lv.{{currentBadge.level || 1}}</view>
        </view>
        <view class="badges-info">
          <view class="badges-title">{{currentBadge.name}}</view>
          <view class="badges-subtitle">进度: {{currentBadge.progress}}</view>
        </view>
        <view class="badges-arrow">
          <image src="/images/arrow.svg" class="arrow-image" />
        </view>
      </view>
    </view>
  </view>

  <!-- 昆虫冷知识区域 - 简化版 -->
  <view class="cold-knowledge-section">
    <!-- <view class="section-header">
      <text class="section-title">冷知识</text>
    </view> -->
    <view class="knowledge-content-wrapper">
      <text class="knowledge-text">{{currentKnowledge.content}}</text>
    </view>
  </view>

  <!-- 我的昆虫收藏区域 -->
  <view class="discovery-section">
    <view class="section-header">
      <text class="section-title">我的昆虫收藏（{{collectedCount}}）</text>
    </view>
    <view class="insects-grid" wx:if="{{recentInsects.length > 0}}">
      <view class="insect-item" wx:for="{{recentInsects}}" wx:key="id" wx:for-item="item" wx:for-index="index" bindtap="goToInsectDetail" bindlongpress="onInsectLongPress" data-id="{{item.id}}" data-index="{{index}}">
        <view class="insect-card">
          <view class="new-badge" wx:if="{{item.isNew}}">新</view>
          <view class="insect-image-wrapper">
            <image class="insect-image" src="{{item.imageUrl}}" mode="aspectFill" binderror="onImageError" data-index="{{index}}" />
          </view>
          <view class="insect-name">{{item.name}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{collectedCount === 0}}">
    <image src="/images/empty_insect.png" class="empty-image" />
    <view class="empty-text">还没有发现任何昆虫</view>
    <view class="empty-subtext">快去探索自然，发现昆虫吧！</view>
    <button class="primary-btn" bindtap="goToCamera">开始探索</button>
  </view>
  
  <!-- 管理入口（仅对管理员显示） -->
  <view class="admin-tools-entry admin-mode" wx:if="{{showAdminEntrance}}" bindtap="goToAdmin">
    <text class="admin-tools-text">管理</text>
  </view>
</view>