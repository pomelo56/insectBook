/* insect-detail.wxss */
.container {
  min-height: 100vh;
  background-color: #f0f9f2;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 0;
  padding-bottom: 30rpx;
}

/* 加载状态 */
.loading-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  min-height: 200rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 8rpx solid #f3f3f3;
  border-top: 8rpx solid #4CAF50;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 8rpx;
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.skeleton-header {
  height: 300rpx;
  width: 100%;
  border-radius: 8rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 30rpx;
  font-size: 28rpx;
  color: #666;
}

/* 错误状态 */
.error-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.error-block {
  padding: 30rpx;
  text-align: center;
  background-color: #fff;
  border-radius: 8rpx;
  margin: 10rpx 0;
  border: 1rpx solid #e6e6e6;
}

.error-block .error-text {
  color: #e64340;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  display: block;
}

.error-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.error-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.retry-btn {
  background-color: #4CAF50;
  color: white;
  border-radius: 8rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
}

/* 详情内容 */
.detail-content {
  flex: 1;
  padding: 0;
}

/* 主内容区 - 使用分块加载状态管理 */
.content {
  flex: 1;
  padding: 0;
}

/* 图片和基本信息 */
/* 修复样式 - 版本号: 1.0.8 */
/* 头部整体容器 */
.header-overall {
  width: 92.5%;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin: 0 auto;
  margin-top: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.insect-image-container {
  width: 100%;
  height: 400rpx; /* 固定高度 */
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-top: 15px;
}

.insect-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

/* 昆虫名称区域样式 */
.name-section {
  padding: 30rpx;
  text-align: center;
}

/* 不再需要单独的basic-info-section样式 */

.insect-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.insect-scientific-name {
  font-size: 28rpx;
  color: #4CAF50;
  font-style: italic;
}

.info-label.module-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4caf50;
  margin-bottom: 20rpx;
}

/* 模块标题通用样式 */
.module-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4caf50;
}

/* 模块容器通用样式 */
.module-container {
  background-color: #fff;
  border-radius: 20rpx;
  margin: 0 auto;
  margin-top: 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
  transition: opacity 0.3s ease;
  width: 85%;
}

/* 确保发现记录模块与头部有足够间距 */
.discovery-module {
  margin-top: 30rpx;
}

.module-container.loading {
  opacity: 0.6;
}

.module-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 0rpx solid #f0f0f0;
}

.loading-text {
  font-size: 24rpx;
  color: #999;
  font-style: italic;
}

/* 模块加载指示器 */
.loading-indicator {
  padding: 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.small-loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #4CAF50;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

/* 发现记录样式 */
.discovery-module {
  padding: 30rpx;
}

.discovery-content {
  width: 100%;
}

.compact-timeline {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 20rpx;
}

.compact-item {
  border-radius: 8rpx;
  overflow: hidden;
}

.compact-content {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.compact-time {
  font-size: 24rpx;
  color: #666;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.compact-image {
  width: 75rpx;
  height: 75rpx;
  border-radius: 10rpx;
  margin-left: 16rpx;
  display: block;
  border: 1px solid #f0f0f0;
}

.compact-image:active {
  opacity: 0.8;
}

/* 当有发现次数但无详细记录时的提示 */
.empty-records-with-count {
  padding: 20rpx;
  text-align: center;
  color: #666;
  font-size: 28rpx;
}

.empty-records-with-count text {
  display: block;
  margin-bottom: 10rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #999;
  font-style: italic;
}

/* 展开更多按钮样式 */
.load-more-btn {
  padding: 20rpx 0;
  text-align: center;
  margin-top: 20rpx;
  border-top: 1px solid #f0f0f0;
}

.load-more-text {
  color: #07c160;
  font-size: 28rpx;
  padding: 10rpx 40rpx;
  border: 1px solid #07c160;
  border-radius: 40rpx;
  display: inline-block;
}

.load-more-text:active {
  background-color: #f0f9ff;
}

/* 百科内容样式 */
.baike-module {
  padding: 30rpx;
}

.baike-section {
  width: 100%;
}

.section-header {
  margin-bottom: 30rpx;
  padding: 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #4caf50;
  margin-bottom: 20rpx;
}

.baike-content {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  white-space: pre-wrap;
  word-break: break-word;
  margin-bottom: 20rpx;
}

.baike-content.empty {
  color: #999;
  text-align: center;
  padding: 20rpx 0;
}

/* 百科信息模块样式 */
.encyclopedia-module {
  padding: 30rpx;
}

.encyclopedia-content {
  margin-top: 20rpx;
}

.encyclopedia-section {
  margin-bottom: 20rpx;
}

.encyclopedia-subsection {
  margin-bottom: 15rpx;
  display: flex;
  align-items: flex-start;
}

.encyclopedia-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #4CAF50;
  margin-bottom: 15rpx;
}

.encyclopedia-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  white-space: pre-wrap;
  word-break: break-word;
  flex: 1;
}

/* 百科文本容器，用于包裹可折叠文本 */
.encyclopedia-text-container {
  position: relative;
  overflow: visible;
}

/* 折叠状态的文本样式 - 限制显示6行 */
.encyclopedia-text-collapsed {
  display: -webkit-box;
  -webkit-line-clamp: 6;
  -webkit-box-orient: vertical;
  overflow: hidden;
  position: relative;
}

/* 折叠时的渐变遮罩效果 */
.encyclopedia-text-collapsed::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0), rgba(255, 255, 255, 1));
}

/* 展开/收起按钮样式 */
.expand-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  padding: 10rpx 0;
  cursor: pointer;
}

.expand-btn-text {
  font-size: 26rpx;
  color: #4CAF50;
  margin-right: 8rpx;
}

.expand-icon {
  font-size: 22rpx;
  color: #4CAF50;
  transition: transform 0.3s ease;
}

.module-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
}

.refresh-btn {
  font-size: 24rpx;
  background-color: transparent;
  color: #4CAF50;
  border: 1px solid #4CAF50;
  padding: 8rpx 20rpx;
}

/* 图片预览模态框样式 */
.image-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 999;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.8);
}

.modal-content {
  position: relative;
  width: 100%;
  height: 80%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.close-btn {
  position: absolute;
  top: 20px;
  right: 20px;
  background-color: rgba(255, 255, 255, 0.3);
  color: white;
  padding: 10px 20px;
  border-radius: 5px;
  font-size: 16px;
  z-index: 1000;
}

/* 响应式调整 */
@media screen and (max-width: 600rpx) {
  .container {
    padding-bottom: 30rpx;
  }
  
  .detail-content {
    padding: 20rpx;
  }
  
  .insect-image-container {
    height: 300rpx;
  }
  
  .insect-name {
    font-size: 40rpx;
  }
  
  .baike-content {
    font-size: 26rpx;
  }
}