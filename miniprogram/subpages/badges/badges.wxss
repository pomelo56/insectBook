/* pages/badges/badges.wxss */
.container {
  background-color: #f0f9f2;
  min-height: 100vh;
  padding-bottom: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0;
  padding-bottom: 100rpx;
}

/* 页面标题 */
.page-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin: 30rpx 0;
  color: #2a9d8f;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
  color: #666;
  font-size: 28rpx;
}

.loading-text {
  display: flex;
  align-items: center;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #4CAF50;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: 15rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
}

.back-btn, .settings-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon, .settings-icon {
  width: 40rpx;
  height: 40rpx;
  color: white;
}

/* 总体进度 */
.progress-container {
  margin: 30rpx;
  padding: 40rpx;
  background-color: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
  width: 85%;
}

.progress-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2a9d8f;
  margin-bottom: 20rpx;
  display: block;
}

.progress-count {
  font-size: 48rpx;
  font-weight: bold;
  color: #4CAF50;
  float: right;
}

.progress-bar {
  width: 100%;
  height: 20rpx;
  background-color: #e0e0e0;
  border-radius: 10rpx;
  margin: 30rpx 0;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: #4CAF50;
  border-radius: 10rpx;
}

.progress-text {
  font-size: 28rpx;
  color: #666;
  display: block;
}

/* 等级体系 */
.levels-section {
  padding: 20rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.trophy-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
}

.section-title text {
  font-size: 32rpx;
  font-weight: bold;
}

/* 等级卡片网格 */
.levels-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 50rpx;
  width: 90%;
  margin: 30rpx 30rpx 0 30rpx;
}

.level-card {
  width: 100%;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 0;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
  position: relative;
  transition: all 0.3s ease;
}

.level-card {
  width: 100%;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 0;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
  position: relative;
  transition: all 0.3s ease;
}

/* 等级卡片 */
.level-card {
  width: 85%;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
  position: relative;
  transition: all 0.3s ease;
}

.level-card.completed {
  border: 2rpx solid #4CAF50;
}

.level-card.current {
  border: 3rpx solid #2196F3;
  box-shadow: 0 4rpx 15rpx rgba(33, 150, 243, 0.2);
  border-radius: 20rpx;
}

.level-badge {
  position: absolute;
  top: 0;
  right: 0;
  background-color: #4CAF50;
  color: white;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  border-bottom-left-radius: 20rpx;
}

.level-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 10rpx;
}

.level-icon image {
  width: 120rpx;
  height: 120rpx;
}

.level-name {
  font-size: 26rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 10rpx;
  display: block;
  line-height: 1.2;
}

.level-status {
  font-size: 24rpx;
  color: #666;
  text-align: center;
  margin-bottom: 20rpx;
  display: block;
}

.level-progress-bar {
  width: 100%;
  height: 12rpx;
  background-color: #e0e0e0;
  border-radius: 6rpx;
  margin-bottom: 10rpx;
  overflow: hidden;
}

.level-progress-fill {
  height: 100%;
  background-color: #9e9e9e;
  border-radius: 6rpx;
}

.level-card.current .level-progress-fill {
  background-color: #9e9e9e;
}

.level-card.completed .level-progress-fill {
  background-color: #4CAF50;
}

/* 不同等级勋章样式 - 移除边框 */
.level-card.level-1 .level-icon {
  background-color: #f5f5f5;
}

.level-card.level-2 .level-icon {
  background-color: #f0f7ff;
}

.level-card.level-3 .level-icon {
  background-color: #fff3e0;
}

.level-card.level-4 .level-icon {
  background-color: #f1f8e9;
}

.level-card.level-5 .level-icon {
  background-color: #e8f5e9;
  box-shadow: 0 0 20rpx rgba(76, 175, 80, 0.3);
}

/* 完成状态的勋章样式增强 - 移除边框 */
.level-card.completed .level-icon {
  background-color: #e3f2fd;
  box-shadow: 0 0 15rpx rgba(33, 150, 243, 0.2);
}

/* 当前等级的等级标签颜色 */
.level-card.current .level-badge {
  background-color: #ff9800;
  font-weight: bold;
}

.level-progress-text {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  display: block;
}

/* 相机按钮 */
.camera-btn {
  position: fixed;
  bottom: 100rpx;
  right: 40rpx;
  width: 120rpx;
  height: 120rpx;
  background-color: #4CAF50;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
  cursor: pointer;
  transition: transform 0.2s ease;
}

.camera-btn:active {
  transform: scale(0.95);
}

.camera-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 5rpx;
}

.camera-text {
  font-size: 20rpx;
  color: white;
}